{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rare Pit Wall",
  "version": "0.17.0",
  "identifier": "com.rareproject.pitwall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rare Pit Wall",
        "width": 960,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rare Project Motorsport",
    "shortDescription": "Il programma del team Rare Project Motorsport per iRacing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzJFODQ0RDIxRDgwQTQKUldTa2dCM1NST2pDM2l6MzFnNk80eXpWTC83SE9XbmNyc1QvSjlEVzBvN1JodnJMRHdKdlNFakgK",
      "endpoints": [
        "https://github.com/gianlugiampu/rare-pit-wall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}